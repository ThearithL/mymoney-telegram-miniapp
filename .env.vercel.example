WEBHOOK_SECRET=GENERATE_A_RANDOM_SECRET
FLASK_SECRET_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET
ADMIN_USER_ID=YOUR_TELEGRAM_USER_ID
ADMIN_PASSWORD_HASH=YOUR_WERKZEUG_PASSWORD_HASH
ADMIN_DISPLAY_NAME=Thearith
