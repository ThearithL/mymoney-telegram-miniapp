BOT_TOKEN=replace_with_botfather_token
APP_URL=https://your-service.onrender.com
WEBHOOK_SECRET=replace_with_random_letters_and_numbers
ADMIN_USER_ID=
ADMIN_PASSWORD_HASH=
FLASK_SECRET_KEY=
# Optional extra users pre-approved by the owner:
ALLOWED_USER_IDS=
DATABASE_URL=sqlite:///money.db
# Use PostgreSQL on hosting: postgresql://user:password@host/database

ADMIN_DISPLAY_NAME=Thearith
# Optional: official Render deploy status polling (keep secrets in Render, not GitHub)
RENDER_API_KEY=
# Generate a private random value with at least 32 characters for the monitor URL
RENDER_WATCH_SECRET=
# Reminder notifications: secret for /ops/reminders/<secret> (falls back to RENDER_WATCH_SECRET)
REMINDER_SECRET=
# Set to 1 to also run reminders from inside the web process every 5 minutes
REMINDER_SCHEDULER=
